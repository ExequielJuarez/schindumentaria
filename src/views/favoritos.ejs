<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="contenedor pagina">
  <h1 class="pagina__titulo titulo">Favoritos <% if (productos.length) { %><sup id="favTotal"><%= productos.length %></sup><% } %></h1>
  <p class="pagina__sub">Las prendas que te gustaron, guardadas en un solo lugar.<% if (!locals.usuarioLocal) { %> <a href="/login?volver=/favoritos" class="enlace">Iniciá sesión</a> para no perderlas.<% } %></p>

  <% if (productos.length) { %>
    <div class="grilla-productos fav-grilla" id="favGrilla">
      <% productos.forEach((p, i) => { %><%- include('partials/tarjeta', { p, indice: i }) %><% }) %>
    </div>
  <% } %>
  <div class="carrito-vacio" id="favVacio" <%= productos.length ? 'hidden' : '' %>>
    <p class="vacio__titulo titulo">Nada por acá</p>
    <p class="apagado">Tocá el corazón en cualquier prenda para guardarla.</p>
    <a href="<%= urlProductos %>" class="btn btn--volt">Ver la tienda</a>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/favoritos.js"></script>
</body>
</html>
