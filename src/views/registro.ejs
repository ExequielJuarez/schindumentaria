<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="acceso">
  <%- include('partials/acceso-marca', { frase: 'Sumate a *SCH*.' }) %>
  <div class="acceso__panel">
    <div class="acceso__form">
      <p class="etiqueta-seccion">Nueva cuenta</p>
      <h1 class="acceso__titulo titulo">Crear cuenta</h1>
      <p class="apagado">Guardá tus datos, seguí tus pedidos y comprá más rápido.</p>

      <form action="/registro" method="POST" novalidate class="acceso__campos">
        <input type="hidden" name="volver" value="<%= volver %>">
        <div class="grilla-form">
          <%- include('partials/campo', { nombre: 'nombre', etiqueta: 'Nombre', valor: datos.nombre || '', errores, atributos: 'autocomplete="given-name" required' }) %>
          <%- include('partials/campo', { nombre: 'apellido', etiqueta: 'Apellido', valor: datos.apellido || '', errores, atributos: 'autocomplete="family-name" required' }) %>
          <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', valor: datos.email || '', errores, atributos: 'autocomplete="email" required', clase: 'completo' }) %>
          <%- include('partials/campo', { nombre: 'telefono', etiqueta: 'Teléfono (opcional)', tipo: 'tel', valor: datos.telefono || '', errores, atributos: 'autocomplete="tel"', clase: 'completo' }) %>
          <%- include('partials/campo-clave', { nombre: 'password', etiqueta: 'Contraseña', errores, atributos: 'autocomplete="new-password" required', ayuda: 'Mínimo 8 caracteres, con letras y números.' }) %>
          <%- include('partials/campo-clave', { nombre: 'confirmar', etiqueta: 'Repetí la contraseña', errores, atributos: 'autocomplete="new-password" required' }) %>
        </div>
        <label class="tilde <%= errores.terminos ? 'tilde--error' : '' %>">
          <input type="checkbox" name="terminos" value="1" <%= datos.terminos ? 'checked' : '' %>>
          <span>Acepto los <a class="enlace" href="/terminos" target="_blank">términos y condiciones</a> y la <a class="enlace" href="/privacidad" target="_blank">política de privacidad</a>.</span>
        </label>
        <% if (errores.terminos) { %><span class="campo__error"><%= errores.terminos.msg %></span><% } %>
        <label class="tilde"><input type="checkbox" name="newsletter" value="1" <%= datos.newsletter ? 'checked' : '' %>> <span>Quiero recibir novedades y promos.</span></label>
        <button type="submit" class="btn btn--volt btn--bloque">Crear mi cuenta</button>
      </form>

      <% if (googleDisponible) { %><div class="separador"><span>o</span></div><div class="acceso__alternativas"><%- include('partials/boton-google') %></div><% } %>
      <p class="acceso__pie">¿Ya tenés cuenta? <a class="enlace" href="/login?volver=<%= encodeURIComponent(volver) %>">Iniciá sesión</a></p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
</body>
</html>
