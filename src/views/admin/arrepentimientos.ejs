<%- include('../partials/head') %>
<%- include('../partials/admin-inicio') %>
<div class="adm-cab"><div><p class="etiqueta-seccion">Res. 424/2020</p><h1 class="adm-titulo titulo">Arrepentimientos</h1></div></div>
<p class="apagado" style="max-width:62ch">El cliente ya recibió su código. Contactalo, coordiná la devolución y el reintegro, y después marcá la solicitud como resuelta.</p>
<% if (!lista.length) { %><div class="panel"><p class="apagado" style="text-align:center;padding:30px">Todavía no hay solicitudes.</p></div><% } %>
<ul class="arr-lista">
  <% lista.forEach((a) => { %>
    <li class="panel arr arr--<%= a.estado %>">
      <header><strong class="arr__codigo titulo"><%= a.codigo %></strong><span class="estado <%= a.estado === 'resuelta' ? 'estado--ok' : 'estado--alerta' %>"><%= a.estado === 'resuelta' ? 'Resuelta' : 'Pendiente' %></span><small class="apagado"><%= formatoFecha(a.fecha, true) %></small></header>
      <dl class="ficha-lista">
        <div><dt>Pedido</dt><dd><% if (a.pedidoId) { %><a class="enlace" href="/admin/pedidos?q=<%= a.pedidoId %>">#<%= a.numeroPedido %></a><% } else { %>#<%= a.numeroPedido %> <small class="resaltado">no coincide con un pedido de ese email: revisar</small><% } %></dd></div>
        <div><dt>Cliente</dt><dd><%= a.nombre %></dd></div>
        <div><dt>Contacto</dt><dd><a class="enlace" href="mailto:<%= a.email %>"><%= a.email %></a><%= a.telefono ? ' · ' + a.telefono : '' %></dd></div>
        <% if (a.motivo) { %><div><dt>Motivo</dt><dd>“<%= a.motivo %>”</dd></div><% } %>
        <% if (a.resueltaEn) { %><div><dt>Resuelta</dt><dd><%= formatoFecha(a.resueltaEn, true) %></dd></div><% } %>
      </dl>
      <form action="/admin/arrepentimientos/<%= a.id %>?_method=PATCH" method="POST"><input type="hidden" name="estado" value="<%= a.estado === 'resuelta' ? 'recibida' : 'resuelta' %>"><button class="btn btn--chico <%= a.estado === 'resuelta' ? 'btn--linea' : 'btn--volt' %>"><%= a.estado === 'resuelta' ? 'Volver a pendiente' : 'Marcar como resuelta' %></button></form>
    </li>
  <% }) %>
</ul>
<%- include('../partials/admin-fin') %>
</body>
</html>
