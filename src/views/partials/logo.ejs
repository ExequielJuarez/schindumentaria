<%# Logo VELT dibujado en SVG. animado: se traza al aparecer · vivo: se vuelve a dibujar al pasar el mouse %>
<% const uid = 'vc' + Math.random().toString(36).slice(2, 8); %>
<svg class="velt-logo <%= locals.animado ? 'velt-logo--anim' : '' %> <%= locals.vivo ? 'velt-logo--vivo' : '' %> <%= locals.clase || '' %>" viewBox="0 0 260 100" role="img" aria-label="VELT">
  <defs><clipPath id="<%= uid %>"><rect x="-10" y="13.5" width="280" height="73"/></clipPath></defs>
  <g clip-path="url(#<%= uid %>)">
    <path pathLength="1" d="M19.14 10L41 78L62.86 10"/>
    <path pathLength="1" d="M129 22H93.1V78H129M93.1 50H122"/>
    <path pathLength="1" d="M151.5 13.5V78H187.5"/>
    <path pathLength="1" d="M201.5 22H247.5M224.5 13.5V86.5"/>
  </g>
</svg>
