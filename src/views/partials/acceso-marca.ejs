<%# Panel de marca de las pantallas de acceso. Recibe: frase (con *resaltado*) %>
<aside class="acceso__marca" aria-hidden="true">
  <img class="acceso__foto" src="/img/inicio/local-sch-1.jpg" alt="">
  <div class="acceso__velo"></div>
  <div class="acceso__marca-contenido">
    <a href="/" class="acceso__logo" tabindex="-1"><%- include('logo', { animado: true }) %></a>
    <p class="acceso__frase titulo"><%- textoRico(locals.frase || 'Tu ropa, *tu calle*.') %></p>
    <p class="acceso__dir"><%= tienda.direccion %></p>
  </div>
</aside>
