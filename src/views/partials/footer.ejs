</main>

<%# ═════════ Beneficios ═════════ %>
<% if (!(locals.contenido && contenido.beneficios)) { %>
<section class="beneficios">
  <div class="contenedor beneficios__grilla">
    <div class="beneficio"><h3>Envío gratis</h3><p>En compras desde <%= formatoPrecio(150000).replace(',00', '') %> a todo el país.</p></div>
    <div class="beneficio"><h3>10% off</h3><p>Pagando por transferencia bancaria.</p></div>
    <div class="beneficio"><h3>Hasta 6 cuotas</h3><p>Con tarjeta, por Mercado Pago.</p></div>
    <div class="beneficio"><h3>Retiro sin costo</h3><p>En nuestro local de La Plata 189.</p></div>
  </div>
</section>
<% } %>

<% const t = locals.tienda || {}; %>
<footer class="footer">
  <a href="/" class="footer__logo-gigante" aria-label="SCH Indumentaria — volver arriba"><%- include('logo', { vivo: true }) %></a>
  <div class="contenedor footer__grilla">
    <div class="footer__marca">
      <a href="/" class="marca-link" aria-label="Inicio"><%- include('logo', { vivo: true }) %></a>
      <p>Streetwear en Santiago del Estero. Remeras, bermudas, camisas y pantalones oversize, elegidos uno por uno.</p>
      <div class="footer__redes">
        <% if (t.instagram) { %><a href="<%= t.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
        <% if (t.tiktok) { %><a href="<%= t.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %>
        <% if (t.whatsapp) { %><a href="<%= t.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
      </div>
    </div>
    <div>
      <h4>Tienda</h4>
      <ul>
        <% (locals.categoriasMenu || []).forEach(cat => { %><li><a href="<%= cat.url %>"><%= cat.nombre %></a></li><% }) %>
      </ul>
    </div>
    <div>
      <h4>Local</h4>
      <div class="footer__datos">
        <span><%= t.direccion %></span>
        <span class="apagado"><%= t.horarios %></span>
        <% if (t.mapa) { %><a href="<%= t.mapa %>" target="_blank" rel="noopener" class="enlace" style="justify-self:start;margin-top:8px">Cómo llegar</a><% } %>
      </div>
    </div>
    <div>
      <h4>Ayuda</h4>
      <ul>
        <li><a href="/terminos#envios">Envíos</a></li>
        <li><a href="/terminos#pagos">Medios de pago</a></li>
        <li><a href="/cambios-y-devoluciones">Cambios y devoluciones</a></li>
        <li><a href="/terminos">Términos y condiciones</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
        <li><a href="/cookies">Cookies</a></li>
        <li><a href="/arrepentimiento" class="footer__arrepentimiento">Botón de arrepentimiento</a></li>
      </ul>
    </div>
  </div>
  <div class="contenedor footer__legal">
    <span>
      © <%= new Date().getFullYear() %> <%= t.nombre || 'SCH Indumentaria' %>.
      <% if (t.razonSocial) { %><%= t.razonSocial %><% if (t.cuit) { %> · CUIT <%= t.cuit %><% } %>.<% } %>
      Todos los derechos reservados.
    </span>
    <span class="footer__oficiales">
      <a href="https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario" target="_blank" rel="noopener">Defensa de las y los consumidores. Para reclamos ingrese aquí</a>
      <% if (t.dataFiscal) { %><a href="<%= t.dataFiscal %>" target="_blank" rel="noopener">Data fiscal</a><% } %>
    </span>
    <span>Visa · Mastercard · Amex · Naranja · Mercado Pago · Transferencia</span>
  </div>
</footer>

<% if (t.whatsapp) { %>
<a href="<%= t.whatsapp %>" class="whatsapp" aria-label="Escribinos por WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.3-2.3l.8-1-1-2L9.5 8z" fill="currentColor"/></svg>
</a>
<% } %>

<div class="aviso-cookies" id="avisoCookies" role="region" aria-label="Aviso de cookies" hidden>
  <p>Usamos solo las cookies necesarias para que la tienda funcione (tu sesión y tu carrito). <a href="/cookies">Más info</a></p>
  <button type="button" class="btn btn--volt btn--chico" id="aceptarCookies">Entendido</button>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<% if (locals.flash) { %><div id="flash" data-mensaje="<%= flash %>" hidden></div><% } %>

<script src="/js/base.js"></script>
