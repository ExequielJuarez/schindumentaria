<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const c = contenido;
  const lineas = (t) => String(t || '').split('\n').filter(Boolean);
  const slides = [c.portada.imagen, c.portada.imagen2, c.portada.imagen3].filter(Boolean);
%>

<%# ═════════ PORTADA: foto a sangre, título enorme y logo dibujándose ═════════ %>
<section class="hero" id="portada">
  <div class="hero__paneles">
    <% slides.forEach((src, i) => { %>
      <figure class="hero__panel" style="--d: <%= i * 0.18 %>s"><img src="<%= src %>" alt="" <%= i === 0 ? 'fetchpriority="high"' : '' %>></figure>
    <% }) %>
  </div>
  <div class="hero__velo" aria-hidden="true"></div>
  <div class="hero__logo" aria-hidden="true"><%- include('partials/logo', { animado: true }) %></div>

  <div class="contenedor hero__contenido">
    <p class="etiqueta-seccion hero__etiqueta"><%= c.portada.etiqueta %></p>
    <h1 class="hero__titulo titulo">
      <% lineas(c.portada.titulo).forEach((l, i) => { %><span class="hero__linea"><span style="--i: <%= i %>"><%- textoRico(l) %></span></span><% }) %>
    </h1>
    <div class="hero__pie">
      <p class="hero__bajada"><%= c.portada.bajada %></p>
      <div class="hero__botones">
        <a href="<%= c.portada.botonLink %>" class="btn btn--volt"><%= c.portada.botonTexto %></a>
        <a href="<%= c.portada.secundarioLink %>" class="btn btn--linea"><%= c.portada.secundarioTexto %></a>
      </div>
    </div>
  </div>
</section>

<%# ═════════ CINTA ═════════ %>
<% if (c.cinta.visible) { %>
<div class="cinta" aria-hidden="true">
  <div class="cinta__pista">
    <% for (let r = 0; r < 4; r++) { lineas(c.cinta.palabras).forEach((w) => { %><span><%- textoRico(w) %></span><i></i><% }) } %>
  </div>
</div>
<% } %>

<%# ═════════ DESTACADOS / NUEVOS INGRESOS ═════════ %>
<% if (c.nuevos.visible && nuevos.length) { %>
<section class="bloque" id="nuevos">
  <header class="bloque__cab bloque__cab--centro rev">
    <p class="etiqueta-seccion"><%= c.nuevos.etiqueta %></p>
    <h2 class="bloque__titulo titulo"><%- textoRico(c.nuevos.titulo) %></h2>
  </header>
  <div class="grilla-productos grilla-productos--sangre">
    <% nuevos.forEach((p, i) => { %><%- include('partials/tarjeta', { p, indice: i }) %><% }) %>
  </div>
  <p class="bloque__mas rev"><a href="<%= c.nuevos.linkUrl %>" class="btn btn--linea"><%= c.nuevos.linkTexto %></a></p>
</section>
<% } %>

<%# ═════════ CATEGORÍAS: cuatro columnas a sangre ═════════ %>
<% if (c.categorias.visible) { %>
<section class="bloque bloque--sin-aire" id="categorias">
  <header class="bloque__cab bloque__cab--centro rev">
    <p class="etiqueta-seccion"><%= c.categorias.etiqueta %></p>
    <h2 class="bloque__titulo titulo"><%- textoRico(c.categorias.titulo) %></h2>
  </header>
  <div class="categorias">
    <% c.categorias.items.forEach((cat, i) => { if (!cat.nombre) return; %>
      <a href="<%= cat.link %>" class="cat rev" style="--d: <%= i * 0.08 %>s">
        <% if (cat.imagen) { %><img src="<%= cat.imagen %>" alt="" loading="lazy"><% } %>
        <span class="cat__num mono"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="cat__pie">
          <strong class="cat__nombre titulo"><%= cat.nombre %></strong>
          <span class="cat__frase"><%= cat.frase %></span>
          <svg class="cat__flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<%# ═════════ LOOKBOOK: carril horizontal ═════════ %>
<% if (c.lookbook.visible) { %>
<section class="bloque" id="lookbook">
  <header class="contenedor bloque__cab bloque__cab--fila rev">
    <div><p class="etiqueta-seccion"><%= c.lookbook.etiqueta %></p><h2 class="bloque__titulo titulo"><%- textoRico(c.lookbook.titulo) %></h2></div>
    <a href="<%= c.lookbook.redLink %>" target="_blank" rel="noopener" class="enlace"><%= c.lookbook.redTexto %> ↗</a>
  </header>
  <div class="carril" tabindex="0" aria-label="Fotos del lookbook, deslizá para ver más">
    <% c.lookbook.fotos.forEach((f, i) => { if (!f.imagen) return; %>
      <figure class="look rev" style="--d: <%= i * 0.08 %>s">
        <img src="<%= f.imagen %>" alt="<%= f.texto %>" loading="lazy">
        <figcaption class="mono"><b><%= String(i + 1).padStart(2, '0') %></b> — <%= f.texto %></figcaption>
      </figure>
    <% }) %>
  </div>
</section>
<% } %>

<%# ═════════ BENEFICIOS ═════════ %>
<% if (c.beneficios.visible) { %>
<section class="beneficios">
  <div class="contenedor beneficios__grilla">
    <% c.beneficios.items.forEach((b) => { if (!b.titulo) return; %><div class="beneficio rev"><h3><%= b.titulo %></h3><p><%= b.texto %></p></div><% }) %>
  </div>
</section>
<% } %>

<%# ═════════ EL LOCAL: bloque invertido (blanco) ═════════ %>
<% if (c.local.visible) { %>
<section class="local" id="local">
  <div class="local__foto rev"><img src="<%= c.local.imagen %>" alt="Interior del local SCH" loading="lazy"></div>
  <div class="local__info rev">
    <p class="etiqueta-seccion"><%= c.local.etiqueta %></p>
    <h2 class="local__titulo titulo"><%- textoRico(c.local.titulo) %></h2>
    <p class="local__bajada"><%= c.local.bajada %></p>
    <dl class="local__datos">
      <div><dt>Dirección</dt><dd><%= c.local.direccion %></dd></div>
      <div><dt>Horarios</dt><dd><%= c.local.horarios %></dd></div>
      <% if (tienda.whatsapp) { %><div><dt>WhatsApp</dt><dd><a href="<%= tienda.whatsapp %>" target="_blank" rel="noopener" class="enlace">Escribinos</a></dd></div><% } %>
    </dl>
    <a href="<%= c.local.botonLink %>" target="_blank" rel="noopener" class="btn btn--negro"><%= c.local.botonTexto %></a>
  </div>
</section>
<% } %>

<%# ═════════ CIERRE ═════════ %>
<% if (c.cierre.visible) { %>
<section class="cierre">
  <div class="contenedor cierre__interior rev">
    <p class="etiqueta-seccion"><%= c.cierre.etiqueta %></p>
    <h2 class="cierre__titulo titulo"><% lineas(c.cierre.titulo).forEach((l) => { %><span><%- textoRico(l) %></span><% }) %></h2>
    <div class="hero__botones">
      <a href="<%= c.cierre.botonLink %>" target="_blank" rel="noopener" class="btn btn--volt"><%= c.cierre.botonTexto %></a>
      <a href="<%= c.cierre.secundarioLink %>" class="btn btn--linea"><%= c.cierre.secundarioTexto %></a>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
<script src="/js/inicio.js"></script>
</body>
</html>
