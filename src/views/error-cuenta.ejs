<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="contenedor error-pagina">
  <p class="error-pagina__codigo titulo"><%= locals.codigo || 404 %></p>
  <h1 class="pagina__titulo titulo"><%= titulo %></h1>
  <p class="pagina__sub"><%= mensaje %></p>
  <div class="error-pagina__botones">
    <a href="/" class="btn btn--volt">Ir al inicio</a>
    <% if (!locals.general) { %><a href="/login" class="btn btn--linea">Iniciar sesión</a><% } %>
  </div>
</section>
<%- include('partials/footer') %>
</body>
</html>
