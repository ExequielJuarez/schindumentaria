<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const p = producto;
  const agotado = p.stock <= 0;
  const esFav = (locals.favoritosIds || []).includes(p.id);
  const precio = (n) => formatoPrecio(n).replace(',00', '');
  const conTransferencia = Math.round(p.precio * (1 - descuentoTransferencia));
  const textoWsp = encodeURIComponent('Hola SCH! Quiero consultar por: ' + p.nombre);
%>

<div class="contenedor">
  <nav class="migas" aria-label="Migas de pan">
    <a href="/">Inicio</a><span>/</span>
    <a href="/categoria/<%= p.categoriaSlug %>"><%= p.categoria %></a><span>/</span>
    <span aria-current="page"><%= p.nombre %></span>
  </nav>
</div>

<section class="contenedor ficha" data-producto data-id="<%= p.id %>" data-stock="<%= p.stock %>" data-tiene-talles="<%= p.talles.length ? 1 : 0 %>">
  <%# ─────── Galería ─────── %>
  <div class="galeria">
    <% if (p.imagenes.length > 1) { %>
      <ol class="galeria__mini" aria-label="Fotos">
        <% p.imagenes.forEach((img, i) => { %>
          <li><button type="button" class="<%= i === 0 ? 'activa' : '' %>" data-foto="<%= img.ruta %>" aria-label="Ver foto <%= i + 1 %>"><img src="<%= img.ruta %>" alt=""></button></li>
        <% }) %>
      </ol>
    <% } %>
    <div class="galeria__principal" id="galeriaPrincipal">
      <% if (p.etiqueta && !agotado) { %><span class="chip galeria__chip"><%= p.etiqueta %></span><% } %>
      <% if (p.imagenes[0]) { %><img id="fotoPrincipal" src="<%= p.imagenes[0].ruta %>" alt="<%= p.nombre %>" fetchpriority="high"><% } %>
      <% if (agotado) { %><span class="tarjeta__agotado">Agotado</span><% } %>
    </div>
  </div>

  <%# ─────── Información ─────── %>
  <div class="ficha__info">
    <p class="etiqueta-seccion"><%= p.categoria %><%= p.subcategoria ? ' · ' + p.subcategoria : '' %></p>
    <h1 class="ficha__nombre titulo"><%= p.nombre %></h1>
    <p class="ficha__resumen"><%= p.resumen %></p>

    <div class="ficha__precio">
      <span class="precio precio--grande"><%= precio(p.precio) %></span>
      <div class="ficha__precio-extra">
        <span><strong class="resaltado"><%= precio(conTransferencia) %></strong> con transferencia <small>(10% off)</small></span>
        <span class="apagado">o <%= p.cuotas %> cuotas de <%= precio(p.precio / p.cuotas) %></span>
      </div>
    </div>

    <form id="formCompra" class="ficha__form" novalidate>
      <% if (p.colores.length > 1) { %>
        <fieldset class="selector" id="selColor">
          <legend>Color: <strong id="colorElegido"><%= p.colores[0].nombre %></strong></legend>
          <div class="selector__colores">
            <% p.colores.forEach((c, i) => { %>
              <label class="color-swatch" title="<%= c.nombre %>">
                <input type="radio" name="color" value="<%= c.nombre %>" <%= i === 0 ? 'checked' : '' %>>
                <span style="background: <%= c.hex %>"></span>
                <span class="sr-only"><%= c.nombre %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
      <% } %>

      <% if (p.talles.length) { %>
        <fieldset class="selector" id="selTalle">
          <legend>Talle: <strong id="talleElegido">elegí uno</strong></legend>
          <div class="selector__talles">
            <% p.talles.forEach((t) => { %>
              <label class="talle"><input type="radio" name="talle" value="<%= t %>" <%= agotado ? 'disabled' : '' %>><span><%= t %></span></label>
            <% }) %>
          </div>
          <p class="campo__error" id="errorTalle" hidden>Elegí tu talle para agregarlo al carrito.</p>
          <a class="ficha__ayuda-talle" href="<%= tienda.whatsapp || tienda.instagram %>?text=<%= textoWsp %>" target="_blank" rel="noopener">¿Dudas con el talle? Consultanos</a>
        </fieldset>
      <% } %>

      <div class="ficha__compra">
        <div class="cantidad" aria-label="Cantidad">
          <button type="button" data-menos aria-label="Menos">−</button>
          <input type="number" id="cantidad" name="cantidad" value="1" min="1" max="<%= Math.min(p.stock, 20) %>" inputmode="numeric" aria-label="Cantidad" <%= agotado ? 'disabled' : '' %>>
          <button type="button" data-mas aria-label="Más">+</button>
        </div>
        <button type="submit" class="btn btn--volt ficha__agregar" id="btnAgregar" <%= agotado ? 'disabled' : '' %>>
          <span><%= agotado ? 'Agotado' : 'Agregar al carrito' %></span>
        </button>
        <button type="button" class="icono-btn ficha__fav" data-fav="<%= p.id %>" aria-pressed="<%= esFav %>" aria-label="Guardar en favoritos">
          <svg viewBox="0 0 24 24" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
        </button>
      </div>
      <% if (!agotado && p.stock <= 5) { %><p class="ficha__stock">Quedan solo <strong><%= p.stock %></strong> unidades.</p><% } %>
    </form>

    <ul class="ficha__garantias">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span>Envío gratis desde <%= precio(150000) %></span></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><span>Retiro sin costo en La Plata 189</span></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="1"/><path d="M3 10h18"/></svg><span>Hasta 6 cuotas con tarjeta</span></li>
    </ul>

    <div class="acordeon">
      <details open>
        <summary>Descripción</summary>
        <div class="acordeon__cuerpo"><% p.descripcion.forEach(par => { %><p><%= par %></p><% }) %></div>
      </details>
      <details>
        <summary>Detalles</summary>
        <div class="acordeon__cuerpo">
          <ul class="destacados"><% p.destacados.forEach(d => { %><li><%= d %></li><% }) %></ul>
          <% if (p.especificaciones.length) { %>
            <dl class="specs"><% p.especificaciones.forEach(([k, v]) => { %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %></dl>
          <% } %>
        </div>
      </details>
      <details>
        <summary>Envíos y cambios</summary>
        <div class="acordeon__cuerpo">
          <p>Enviamos a todo el país. Compras desde <%= precio(150000) %> con envío gratis; también podés retirar sin costo en el local.</p>
          <p>Para cambios y devoluciones mirá la <a class="enlace" href="/cambios-y-devoluciones">política completa</a>.</p>
        </div>
      </details>
    </div>
  </div>
</section>

<% if (relacionados.length) { %>
<section class="bloque relacionados">
  <div class="contenedor">
    <header class="bloque__cab rev"><p class="etiqueta-seccion">Completá el look</p><h2 class="bloque__titulo titulo">También te <em>puede gustar</em></h2></header>
    <div class="grilla-productos">
      <% relacionados.forEach((r, i) => { %><%- include('partials/tarjeta', { p: r, indice: i }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%# Barra de compra fija en el celular %>
<div class="barra-compra" id="barraCompra" aria-hidden="true">
  <div><strong class="precio"><%= precio(p.precio) %></strong><small><%= p.nombre %></small></div>
  <button type="button" class="btn btn--volt btn--chico" id="barraAgregar" <%= agotado ? 'disabled' : '' %>><%= agotado ? 'Agotado' : 'Agregar' %></button>
</div>

<%- include('partials/footer') %>
<script src="/js/producto.js"></script>
</body>
</html>
