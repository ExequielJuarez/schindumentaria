<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="acceso">
  <%- include('partials/acceso-marca', { frase: 'Entrá y *armá tu look*.' }) %>
  <div class="acceso__panel">
    <div class="acceso__form">
      <p class="etiqueta-seccion">Tu cuenta</p>
      <h1 class="acceso__titulo titulo">Iniciar sesión</h1>

      <% if (errorGeneral) { %><div class="aviso aviso--error" role="alert"><%= errorGeneral %></div><% } %>

      <form action="/login" method="POST" novalidate class="acceso__campos">
        <input type="hidden" name="volver" value="<%= volver %>">
        <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', valor: datos.email || '', errores, atributos: 'autocomplete="email" required autofocus' }) %>
        <%- include('partials/campo-clave', { nombre: 'password', etiqueta: 'Contraseña', errores, atributos: 'autocomplete="current-password" required' }) %>
        <div class="acceso__fila">
          <label class="tilde"><input type="checkbox" name="recordar" value="1" <%= datos.recordar ? 'checked' : '' %>> <span>Mantener la sesión</span></label>
          <% if (codigoDisponible) { %><a class="enlace" href="/login/codigo?motivo=recuperar&volver=<%= encodeURIComponent(volver) %>">¿La olvidaste?</a><% } %>
        </div>
        <button type="submit" class="btn btn--volt btn--bloque">Entrar</button>
      </form>

      <div class="separador"><span>o</span></div>
      <div class="acceso__alternativas">
        <% if (googleDisponible) { %><%- include('partials/boton-google') %><% } %>
        <% if (codigoDisponible) { %><a href="/login/codigo?volver=<%= encodeURIComponent(volver) %>" class="btn btn--linea btn--bloque">Entrar con un código por email</a><% } %>
      </div>

      <p class="acceso__pie">¿No tenés cuenta? <a class="enlace" href="/registro?volver=<%= encodeURIComponent(volver) %>">Creá una</a></p>

      <% if (mostrarDemo) { %>
      <aside class="demo" aria-label="Usuarios de prueba">
        <p class="demo__titulo">Usuarios de prueba</p>
        <div class="demo__botones">
          <button type="button" class="btn btn--linea btn--chico" data-demo-email="demo@tienda.com" data-demo-clave="Demo1234">Cliente</button>
          <button type="button" class="btn btn--linea btn--chico" data-demo-email="admin@tienda.com" data-demo-clave="Admin1234">Admin</button>
        </div>
      </aside>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
<script src="/js/login.js"></script>
</body>
</html>
