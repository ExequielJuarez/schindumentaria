<%- include('partials/head') %>
<%- include('partials/header') %>
<% const e = errores; const v = (k) => datos[k] ?? ''; const hayErrores = Object.keys(e).length > 0; %>

<section class="contenedor pagina checkout">
  <%- include('partials/pasos', { paso: 2 }) %>
  <h1 class="pagina__titulo titulo">Tus datos</h1>

  <div class="checkout__grilla">
    <form action="/checkout/datos" method="POST" class="checkout__form" id="formDatos" novalidate>
      <% if (hayErrores) { %><div class="aviso aviso--error" role="alert">Revisá los campos marcados para poder seguir.</div><% } %>
      <% if (!locals.usuarioLocal) { %>
        <p class="aviso aviso--info">¿Ya tenés cuenta? <a class="enlace" href="/login?volver=/checkout/datos">Iniciá sesión</a> y completamos tus datos. También podés comprar sin cuenta.</p>
      <% } %>

      <fieldset class="bloque-form">
        <legend><span>1</span> Contacto</legend>
        <div class="grilla-form">
          <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', valor: v('email'), errores: e, atributos: 'autocomplete="email" required', clase: 'completo' }) %>
          <%- include('partials/campo', { nombre: 'nombre', etiqueta: 'Nombre', valor: v('nombre'), errores: e, atributos: 'autocomplete="given-name" required' }) %>
          <%- include('partials/campo', { nombre: 'apellido', etiqueta: 'Apellido', valor: v('apellido'), errores: e, atributos: 'autocomplete="family-name" required' }) %>
          <%- include('partials/campo', { nombre: 'telefono', etiqueta: 'Teléfono', tipo: 'tel', valor: v('telefono'), errores: e, atributos: 'autocomplete="tel" placeholder="385 4000000" required' }) %>
          <%- include('partials/campo', { nombre: 'dni', etiqueta: 'DNI', valor: v('dni'), errores: e, atributos: 'inputmode="numeric" maxlength="8" placeholder="Sin puntos" required' }) %>
        </div>
      </fieldset>

      <fieldset class="bloque-form">
        <legend><span>2</span> Entrega</legend>
        <div class="opciones-entrega">
          <label class="opcion"><input type="radio" name="entrega" value="domicilio" <%= v('entrega') !== 'retiro' ? 'checked' : '' %>><span><strong>Envío a domicilio</strong><small>A todo el país</small></span></label>
          <label class="opcion"><input type="radio" name="entrega" value="retiro" <%= v('entrega') === 'retiro' ? 'checked' : '' %>><span><strong>Retiro en el local</strong><small><%= tienda.direccion %> · <%= tienda.horarios %></small></span><span class="opcion__extra">Gratis</span></label>
        </div>
        <% if (e.entrega) { %><span class="campo__error"><%= e.entrega.msg %></span><% } %>

        <div class="grilla-form" id="camposDomicilio" <%= v('entrega') === 'retiro' ? 'hidden' : '' %>>
          <%- include('partials/campo', { nombre: 'calle', etiqueta: 'Calle', valor: v('calle'), errores: e, atributos: 'autocomplete="address-line1"' }) %>
          <%- include('partials/campo', { nombre: 'numero', etiqueta: 'Altura', valor: v('numero'), errores: e, atributos: 'maxlength="6" placeholder="1234 o S/N"' }) %>
          <%- include('partials/campo', { nombre: 'piso', etiqueta: 'Piso / depto (opcional)', valor: v('piso'), errores: e }) %>
          <%- include('partials/campo', { nombre: 'codigoPostal', etiqueta: 'Código postal', valor: v('codigoPostal'), errores: e, atributos: 'inputmode="numeric" maxlength="4" placeholder="4200" autocomplete="postal-code"' }) %>
          <%- include('partials/campo', { nombre: 'ciudad', etiqueta: 'Ciudad / localidad', valor: v('ciudad'), errores: e, atributos: 'autocomplete="address-level2"' }) %>
          <div class="campo <%= e.provincia ? 'campo--error' : '' %>">
            <label for="c-provincia">Provincia</label>
            <select id="c-provincia" name="provincia" autocomplete="address-level1">
              <option value="">Elegí una provincia</option>
              <% provincias.forEach((pv) => { %><option value="<%= pv %>" <%= v('provincia') === pv ? 'selected' : '' %>><%= pv %></option><% }) %>
            </select>
            <% if (e.provincia) { %><span class="campo__error"><%= e.provincia.msg %></span><% } %>
          </div>
        </div>
        <div class="campo completo <%= e.notas ? 'campo--error' : '' %>">
          <label for="c-notas">Notas para la entrega (opcional)</label>
          <textarea id="c-notas" name="notas" maxlength="300" rows="3" placeholder="Horario, referencias, indicaciones…"><%= v('notas') %></textarea>
          <% if (e.notas) { %><span class="campo__error"><%= e.notas.msg %></span><% } %>
        </div>
      </fieldset>

      <fieldset class="bloque-form">
        <legend><span>3</span> Facturación</legend>
        <div class="opciones-entrega">
          <label class="opcion"><input type="radio" name="facturacion" value="consumidor" <%= v('facturacion') !== 'facturaA' ? 'checked' : '' %>><span><strong>Consumidor final</strong></span></label>
          <label class="opcion"><input type="radio" name="facturacion" value="facturaA" <%= v('facturacion') === 'facturaA' ? 'checked' : '' %>><span><strong>Factura A</strong><small>Para empresas y responsables inscriptos</small></span></label>
        </div>
        <div class="grilla-form" id="camposFactura" <%= v('facturacion') === 'facturaA' ? '' : 'hidden' %>>
          <%- include('partials/campo', { nombre: 'cuit', etiqueta: 'CUIT', valor: v('cuit'), errores: e, atributos: 'inputmode="numeric" maxlength="13" placeholder="20-12345678-9"' }) %>
          <%- include('partials/campo', { nombre: 'razonSocial', etiqueta: 'Razón social', valor: v('razonSocial'), errores: e }) %>
        </div>
      </fieldset>

      <label class="tilde"><input type="checkbox" name="newsletter" value="1" <%= datos.newsletter ? 'checked' : '' %>> <span>Quiero enterarme de los nuevos ingresos y promos.</span></label>

      <div class="checkout__acciones">
        <a href="/carrito" class="btn btn--linea">Volver</a>
        <button type="submit" class="btn btn--volt">Continuar al pago →</button>
      </div>
    </form>

    <%- include('partials/resumen-pedido', { resumen }) %>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/checkout-datos.js"></script>
</body>
</html>
